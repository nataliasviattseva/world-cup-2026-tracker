# Spring Boot Application Environment Variables
# Copy this file to .env and replace with your actual values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/tracker_database?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Email Configuration (for notifications)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# Live Score API Configuration
# Get your API credentials from https://livescore-api.com/profile
LIVESCORE_API_KEY=AAAAAAAAAAAAAAAA
LIVESCORE_API_SECRET=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
LIVESCORE_API_BASE_URL=https://livescore-api.com/api-client
